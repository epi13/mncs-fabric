[Unit]
Description=MNCS Fabric persistent controller
After=default.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/mncs-fabric/controller.env
ExecStart=%h/.local/share/mncs-fabric/venv/bin/mncs-fabric controller service run --state %h/.local/state/mncs-fabric/lifecycle.jsonl --registry %h/.local/state/mncs-fabric/workers.json --worker-state %h/.local/state/mncs-fabric/controller-workers.jsonl --execution-bundle-root %h/.local/state/mncs-fabric/execution-bundles --capability-refresh-seconds 240
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
