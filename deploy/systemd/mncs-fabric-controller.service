[Unit]
Description=MNCS Fabric persistent controller
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mncs-fabric controller --controller-id epi13-local-harness service run --state %h/.local/state/mncs-fabric/lifecycle.jsonl --registry %h/.local/state/mncs-fabric/workers.json --worker-state %h/.local/state/mncs-fabric/controller-workers.jsonl --execution-bundle-root %h/.local/state/mncs-control-mcp/fabric-bundles
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
