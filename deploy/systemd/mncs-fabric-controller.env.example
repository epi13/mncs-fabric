# Copy to ~/.config/mncs-fabric/controller.env and chmod 600.
MNCS_FABRIC_CONTROLLER_ID=mncs-fabric-controller

# Add all six rendezvous values together when this controller accepts workers.
# MNCS_FABRIC_RENDEZVOUS_HOST=0.0.0.0
# MNCS_FABRIC_RENDEZVOUS_PORT=7444
# MNCS_FABRIC_RENDEZVOUS_CA=/home/USER/.config/mncs-fabric/controller/tls/ca.pem
# MNCS_FABRIC_RENDEZVOUS_CERTIFICATE=/home/USER/.config/mncs-fabric/controller/tls/controller.pem
# MNCS_FABRIC_RENDEZVOUS_KEY=/home/USER/.config/mncs-fabric/controller/tls/controller.key
# MNCS_FABRIC_RENDEZVOUS_TRUST_STATE=/home/USER/.local/state/mncs-fabric/controller-trust.jsonl
