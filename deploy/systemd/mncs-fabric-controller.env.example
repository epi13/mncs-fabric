# Copy to ~/.config/mncs-fabric/controller.env and chmod 600.
#
# These values are optional. Without a complete rendezvous configuration the
# controller continues to serve registered direct worker endpoints through the
# persistent consumer socket. When all six values are present, the same
# controller also accepts worker-initiated mTLS rendezvous sessions.
#
# Use absolute host paths. The files remain operator-owned and are not copied
# into the systemd unit or exposed through the public controller status.
MNCS_FABRIC_RENDEZVOUS_HOST=0.0.0.0
MNCS_FABRIC_RENDEZVOUS_PORT=7444
MNCS_FABRIC_RENDEZVOUS_CA=/home/USER/.local/state/mncs-fabric/tls/ca.pem
MNCS_FABRIC_RENDEZVOUS_CERTIFICATE=/home/USER/.local/state/mncs-fabric/tls/controller.pem
MNCS_FABRIC_RENDEZVOUS_KEY=/home/USER/.local/state/mncs-fabric/tls/controller.key
MNCS_FABRIC_RENDEZVOUS_TRUST_STATE=/home/USER/.local/state/mncs-fabric/controller-trust.jsonl
