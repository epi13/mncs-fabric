# Copy to ~/.config/mncs-fabric/workers/WORKER_ID.env and chmod 600.
MNCS_FABRIC_CONTROLLER_ID=epi13-local-harness
MNCS_FABRIC_CONTROLLER_HOST=CONTROLLER_LAN_IP
MNCS_FABRIC_CONTROLLER_PORT=7444
MNCS_FABRIC_BUNDLE_ROOT=/home/USER/.local/state/mncs-fabric/worker-bundles
MNCS_FABRIC_WORKER_STATE=/home/USER/.local/state/mncs-fabric/worker.jsonl
MNCS_FABRIC_TRUST_STATE=/home/USER/.local/state/mncs-fabric/worker-trust.jsonl
MNCS_FABRIC_CA=/home/USER/.local/state/mncs-fabric/tls/ca.pem
MNCS_FABRIC_CERTIFICATE=/home/USER/.local/state/mncs-fabric/tls/worker.pem
MNCS_FABRIC_CERTIFICATE_KEY=/home/USER/.local/state/mncs-fabric/tls/worker.key
