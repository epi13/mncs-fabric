# Copy to ~/.config/mncs-fabric/workers/WORKER_ID.env and chmod 600.
MNCS_FABRIC_CONTROLLER_ID=mncs-fabric-controller
MNCS_FABRIC_CONTROLLER_HOST=CONTROLLER_LAN_IP
MNCS_FABRIC_CONTROLLER_PORT=7444
MNCS_FABRIC_BUNDLE_ROOT=/home/USER/.local/state/mncs-fabric/workers/WORKER_ID/bundles
MNCS_FABRIC_WORKER_STATE=/home/USER/.local/state/mncs-fabric/workers/WORKER_ID/worker.jsonl
MNCS_FABRIC_TRUST_STATE=/home/USER/.local/state/mncs-fabric/workers/WORKER_ID/worker-trust.jsonl
MNCS_FABRIC_CA=/home/USER/.local/state/mncs-fabric/workers/WORKER_ID/tls/ca.pem
MNCS_FABRIC_CERTIFICATE=/home/USER/.local/state/mncs-fabric/workers/WORKER_ID/tls/worker.pem
MNCS_FABRIC_CERTIFICATE_KEY=/home/USER/.local/state/mncs-fabric/workers/WORKER_ID/tls/worker.key
MNCS_FABRIC_CONTAINMENT_MODE=required
