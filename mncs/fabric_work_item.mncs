mncs 0.6;

// Fabric scheduled-work item decisions as language-owned source.
//
// This module reconstructs the pure work-item relations inside
// `src/mncs_fabric/work_queue.py` (terminal classification, priority
// order, dispatch holds) as finite-domain MNCS source. Python remains
// authoritative for ledgers, clocks, idempotency hashing, dispatch
// effects, and the queue fold itself; this module owns the per-item
// decisions the tick consults.
//
// Boundaries (pinned by the corpus):
// - terminal states are exactly COMPLETED, FAILED, CANCELLED. Every
//   other recorded state (QUEUED, DISPATCHED, operator PAUSED/RESUMED
//   markers) folds to NonTerminal; unknown strings stay host-side
//   errors, never a status value.
// - lower priority values dispatch first; the work-id tie-break over
//   identity text stays host-side.
// - the hold reason answers why an item did not dispatch: an operator
//   pause outranks missing eligibility.
module fabric.work_item;

enum WorkState { Queued, Dispatched, Completed, Failed, Cancelled, NonTerminal }

enum HoldReason { Dispatch, PausedHold, NoEligibleHold }

fn is_terminal(state: WorkState) -> (result: bool) {
    return match state {
        Queued => false,
        Dispatched => false,
        Completed => true,
        Failed => true,
        Cancelled => true,
        NonTerminal => false,
    };
}

// Lower priority values dispatch first (the queue sorts ascending).
fn higher_priority(a_priority: i32, b_priority: i32) -> (result: bool) {
    return a_priority < b_priority;
}

fn hold_reason(paused: bool, eligible_found: bool) -> (result: HoldReason) {
    if paused {
        return HoldReason.PausedHold;
    }
    if eligible_found {
        return HoldReason.Dispatch;
    }
    return HoldReason.NoEligibleHold;
}

// The experiment targets these wrappers so source-level call semantics
// are in the executed path rather than merely present in the module.
fn candidate_terminal(state: WorkState) -> (result: bool) {
    return is_terminal(state);
}

fn candidate_priority(a_priority: i32, b_priority: i32) -> (result: bool) {
    return higher_priority(a_priority, b_priority);
}

fn candidate_hold(paused: bool, eligible_found: bool) -> (result: HoldReason) {
    return hold_reason(paused, eligible_found);
}
