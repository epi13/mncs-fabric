{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MNCS Fabric execution target reference 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_identity", "execution_class", "required_capabilities", "tool_capability_identity", "runtime_identity", "consumer_context_identity", "consumer_authorization_identity", "require_current_membership", "require_authenticated_presence", "required_availability", "liveness_max_age_seconds", "capability_max_age_seconds", "fallback_policy", "claim_boundary", "target_identity"],
  "properties": {
    "schema_version": {"const": "mncs-fabric.execution-target-reference.v0.1"},
    "worker_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "execution_class": {"const": "bounded-argv-workload"},
    "required_capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,255}$"}},
    "tool_capability_identity": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_identity": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "consumer_context_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "consumer_authorization_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "require_current_membership": {"const": true},
    "require_authenticated_presence": {"const": true},
    "required_availability": {"const": "AVAILABLE"},
    "liveness_max_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "capability_max_age_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
    "fallback_policy": {"const": "NONE"},
    "claim_boundary": {"type": "string"},
    "target_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
