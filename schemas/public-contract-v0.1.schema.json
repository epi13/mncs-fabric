{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MNCS Fabric public consumer contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "public_api_version", "package_name", "package_version", "job_plan_schema", "execution_record_schema", "cohort_schema", "node_capability_schema", "node_resource_schema", "placement_request_schema", "placement_admission_schema", "placement_observation_schema", "placement_reference_schema", "worker_description_schema", "worker_liveness_schema", "work_item_schema", "execution_collection_schema", "protocol_schema", "receipt_profile", "execution_bundle_profile", "challenge_profile", "features", "capability_namespace", "claim_boundary", "contract_identity", "runtime_profile_schema", "runtime_observation_schema", "runtime_binding_schema"],
  "properties": {
    "schema_version": {"const": "mncs-fabric.public-contract.v0.1"},
    "public_api_version": {"const": "mncs-fabric.api.v0.1"},
    "package_name": {"const": "mncs-fabric"},
    "package_version": {"type": "string", "minLength": 1},
    "job_plan_schema": {"const": "mncs-fabric.job-plan.v0.1"},
    "execution_record_schema": {"const": "mncs-fabric.execution-record.v0.1"},
    "cohort_schema": {"const": "mncs-fabric.cohort-result.v0.1"},
    "node_capability_schema": {"const": "mncs-fabric.node-capabilities.v0.1"},
    "node_resource_schema": {"const": "mncs-fabric.node-resources.v0.1"},
    "placement_request_schema": {"const": "mncs-fabric.execution-placement-request.v0.1"},
    "placement_admission_schema": {"const": "mncs-fabric.placement-admission.v0.1"},
    "placement_observation_schema": {"const": "mncs-fabric.execution-placement-observation.v0.1"},
    "placement_reference_schema": {"const": "mncs-fabric.placement-reference.v0.1"},
    "worker_description_schema": {"const": "mncs-fabric.worker-description.v0.2"},
    "worker_liveness_schema": {"const": "mncs-fabric.worker-liveness.v0.1"},
    "work_item_schema": {"const": "mncs-fabric.work-item.v0.1"},
    "execution_collection_schema": {"const": "mncs-fabric.execution-collection.v0.1"},
    "protocol_schema": {"const": "mncs-fabric.protocol.v0.1"},
    "receipt_profile": {"const": "0.1-experimental"},
    "execution_bundle_profile": {"const": "0.1-experimental"},
    "challenge_profile": {"const": "0.1-experimental"},
    "runtime_profile_schema": {"const": "mncs-fabric.runtime-profile.v0.1"},
    "runtime_observation_schema": {"const": "mncs-fabric.runtime-observation.v0.1"},
    "runtime_binding_schema": {"const": "mncs-fabric.runtime-binding.v0.1"},
    "features": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "capability_namespace": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "contract_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
