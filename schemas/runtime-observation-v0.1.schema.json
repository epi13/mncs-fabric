{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mncs-fabric.runtime-observation.v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_identity", "runtime_profile_identity", "runtime_kind", "python_version", "python_executable_identity", "accelerator_backend", "accelerator", "driver_identity", "runtime_version", "runtime_execution_probe", "precision_probes", "probe_identity", "captured_at", "observation_source", "claim_boundary", "runtime_observation_identity"],
  "properties": {
    "schema_version": {"const": "mncs-fabric.runtime-observation.v0.1"},
    "worker_identity": {"type": "string"},
    "runtime_profile_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_kind": {"const": "python"},
    "python_version": {"type": "string"},
    "python_executable_identity": {"type": ["string", "null"]},
    "accelerator_backend": {"type": ["string", "null"]},
    "accelerator": {"type": ["string", "null"]},
    "driver_identity": {"type": ["string", "null"]},
    "runtime_version": {"type": ["string", "null"]},
    "runtime_execution_probe": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "precision_probes": {"type": "object"},
    "probe_identity": {"type": ["string", "null"]},
    "captured_at": {"type": "string"},
    "observation_source": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "runtime_observation_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
