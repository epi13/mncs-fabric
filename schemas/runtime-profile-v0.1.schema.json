{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mncs-fabric.runtime-profile.v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_identity", "runtime_kind", "logical_name", "python_version", "executable_identity", "captured_at", "observation_source", "claim_boundary", "runtime_profile_identity"],
  "properties": {
    "schema_version": {"const": "mncs-fabric.runtime-profile.v0.1"},
    "worker_identity": {"type": "string"},
    "runtime_kind": {"const": "python"},
    "logical_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "python_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "executable_identity": {"type": ["string", "null"]},
    "captured_at": {"type": "string"},
    "observation_source": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "runtime_profile_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
